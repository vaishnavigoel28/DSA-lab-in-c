#include <stdio.h>
#define MAX 5

int stack[MAX];
int top = -1;

// Push operation
void push(int value)
{
    if (top == MAX - 1)
    {
        printf("Error: Stack Overflow\n");
    }
    else
    {
        top++;
        stack[top] = value;
        printf("%d pushed into stack\n", value);
    }
}

// Pop operation
void pop()
{
    if (top == -1)
    {
        printf("Error: Stack Underflow\n");
    }
    else
    {
        printf("%d popped from stack\n", stack[top]);
        top--;
    }
}

// Peek operation
void peek()
{
    if (top == -1)
    {
        printf("Error: Stack is empty\n");
    }
    else
    {
        printf("Top element = %d\n", stack[top]);
    }
}

// Display operation
void display()
{
    int i;

    if (top == -1)
    {
        printf("Error: Stack is empty\n");
    }
    else
    {
        printf("Stack elements: ");
        for (i = top; i >= 0; i--)
        {
            printf("%d ", stack[i]);
        }
        printf("\n");
    }
}

int main()
{
    push(10);
    push(20);
    push(30);

    display();

    peek();

    pop();
    display();

    return 0;
}
